<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Signal Relay // N-Relay</title>
    <link rel="stylesheet" href="css/styles.css" />
  </head>

  <body>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="scanlines" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>

    <main class="app">
      <header class="topbar">
        <div class="brand">
          <span class="dot"></span>
          <div class="title-wrap">
            <div class="title">N-Relay</div>
            <div class="subtitle">hacker/spy single-page relay</div>
          </div>
        </div>

        <div class="status">
          <span class="pill online">LINK: ONLINE</span>
          <span class="pill">MODE: STEALTH</span>
        </div>
      </header>

      <section class="panel">
        <div class="panel-head">
          <h1 class="panel-title">Transmit Message</h1>
          <div class="panel-meta">
            <span class="meta-item">Noisy channel</span>
            <span class="meta-item">Local demo UI</span>
          </div>
        </div>

        {% block input %}{% endblock %}
        {% block output %}{% endblock %}

      </section>

      <footer class="footer">
        <div class="foot-left">“They can’t read it if the signal is buried.”</div>
        <div class="foot-right">
          <span class="mono">v0.1</span>
          <span class="sep">•</span>
          <span class="mono">static UI</span>
        </div>
      </footer>
    </main>

    <script type="module" src="/client.js"></script>

  </body>
</html>
