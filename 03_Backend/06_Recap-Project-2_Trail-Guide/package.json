    "sanitize-html": "^2.17.6",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/nunjucks": "^3.2.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/sqlite3": "^3.1.11",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
